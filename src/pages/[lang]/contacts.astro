---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { langPaths, CONTACT, type Lang } from '../../lib/site';
import { t } from '../../i18n/ui';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const u = t(lang);
---
<Base lang={lang} title={u.contacts.title} description={u.contacts.lead} path="/contacts/">
  <Crumbs lang={lang} trail={[[u.contacts.title]]} />
  <div class="wrap head"><h1>{u.contacts.title}</h1><p class="lead">{u.contacts.lead}</p></div>
  <div class="wrap order">
    <div>
      <div class="panel"><p class="eyebrow">{u.contacts.phone}</p><a class="big" href={`tel:${CONTACT.tel}`}>{CONTACT.phone}</a></div>
      <div class="panel"><p class="eyebrow">{u.contacts.email}</p><a class="big" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></div>
    </div>
    <div>
      <div class="panel"><p class="eyebrow">{u.contacts.where}</p><p>{u.contacts.whereText}</p>
        <p class="eyebrow">{u.contacts.delivery}</p><p style="margin:0">{u.facts.delivery}. {u.facts.pay}.</p></div>
    </div>
  </div>
</Base>
